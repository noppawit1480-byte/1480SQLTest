# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- main platform database (users, content, progress) ---
MAIN_DB_USER=sqlab
MAIN_DB_PASSWORD=CHANGE_ME_main_db_password
MAIN_DB_NAME=sqlab

# --- sandbox cluster (runs learner SQL; separate server) ---
SANDBOX_ADMIN_PASSWORD=CHANGE_ME_sandbox_superuser_password
SANDBOX_READER_PASSWORD=CHANGE_ME_reader_password
# used to derive per-user sandbox role passwords (HMAC) — long random string
SANDBOX_ROLE_SECRET=CHANGE_ME_long_random_secret

# --- app ---
# set true when served over HTTPS
COOKIE_SECURE=false
QUERY_TIMEOUT_MS=5000
MAX_RESULT_ROWS=1000
# optional: create an admin account on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEB_PORT=3000
