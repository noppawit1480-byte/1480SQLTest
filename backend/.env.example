# Local development without Docker (see docs/INSTALL.md)
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5433/sqlplatform
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=5434
SANDBOX_ADMIN_USER=postgres
SANDBOX_ADMIN_PASSWORD=CHANGE_ME
SANDBOX_READER_PASSWORD=CHANGE_ME
SANDBOX_ROLE_SECRET=CHANGE_ME_long_random_secret
